# Copie para .env e preencha (o .env NÃO vai para o GitHub).
# Supabase -> Project Settings -> API
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Use a chave service_role (Settings -> API -> service_role).
# Ela só pode ficar no servidor: nunca no frontend, nunca no GitHub.
SUPABASE_KEY=cole-aqui-a-chave-service_role

# De onde o navegador pode chamar a API. Aceita lista separada por vírgula.
# O GitHub Pages do projeto + o servidor local de desenvolvimento.
CORS_ORIGIN=https://sousaonix.github.io,http://localhost:5173,http://127.0.0.1:5500

# Local apenas. No Render a porta é definida pela plataforma.
PORT=3000
